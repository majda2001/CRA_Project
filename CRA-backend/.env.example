# Copier ce fichier en .env (dans CRA-backend/) puis renseigner les valeurs.
# Ne jamais committer le fichier .env.

# Compte administrateur créé au démarrage
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret de signature des JWT (chaîne aléatoire longue, ex. : openssl rand -base64 32)
JWT_SECRET=

# SMTP pour les e-mails d'activation (ex. mot de passe d'application Gmail)
SMTP_USERNAME=
SMTP_PASSWORD=

# URL de la page d'activation côté frontend
FRONTEND_ACTIVATION_URL=http://localhost:4200/activate

# Règles métier
APP_TIMEZONE=Africa/Casablanca
CRA_WINDOW_START_DAY=
CRA_WINDOW_END_DAY=
